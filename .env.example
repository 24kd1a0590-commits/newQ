# MEDIQ - Environment Configuration
# Copy this file to .env and fill in your Supabase credentials when connecting to a real backend.

# Supabase API URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Publishable / Anon Key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
